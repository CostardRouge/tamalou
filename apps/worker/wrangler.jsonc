{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Online play (docs/SPEC.md §5.3, ADR-0004): one Worker serves the web app (apps/web/dist) and the rooms API under
  // /api; each room is one Durable Object holding a packages/room Room in memory.
  "name": "tamalou",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "observability": { "enabled": true },
  // No routes on purpose: a custom domain is added in the dashboard, and deploys keep it.
  // Files are served first; the Worker runs for /api/* only. An address with no file gets the build's 404.html with a
  // 404 status (apps/web/build/notfound.ts): never the home page, whose relative links break at another depth.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomObject" },
      // The anonymous usage statistics (ADR-0024): the one thing this Worker keeps.
      { "name": "USAGE", "class_name": "UsageObject" },
      // The ranked players (ADR-0029): kept, and backed up.
      { "name": "LADDER", "class_name": "LadderObject" }
    ]
  },
  // SQLite-backed objects are the ones the free plan offers; the room keeps nothing in storage anyway.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomObject"] },
    { "tag": "v2", "new_sqlite_classes": ["UsageObject"] },
    { "tag": "v3", "new_sqlite_classes": ["LadderObject"] }
  ],
  // Per-IP limit on new rooms (the period is 10 or 60 seconds).
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    // Per-IP limit on usage reports: a game sends two or three.
    { "name": "USAGE_LIMIT", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
    // Per-IP limit on the ranked profile's calls: a screen makes one or two.
    { "name": "LADDER_LIMIT", "namespace_id": "2003", "simple": { "limit": 20, "period": 60 } }
  ],
  // The admin page's settings (admin.ts): the issuer and client id here, the two secrets with `wrangler secret put`
  // (SESAME_CLIENT_SECRET, ADMIN_SECRET).
  "vars": { "SESAME_ISSUER": "https://auth.steeve.website", "SESAME_CLIENT_ID": "tamalou" }
}
